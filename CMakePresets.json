{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-check",
      "displayName": "CPU check build (no GPU, no network)",
      "description": "The fast check: the CPU-only engine pieces and every test that needs no GPU and no model. STRATA_NATIVE_EXPERTS=OFF, so ggml is not needed. tools/check runs this preset.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STRATA_BUILD_TESTS": "ON",
        "STRATA_NATIVE_EXPERTS": "OFF"
      }
    },
    {
      "name": "cpu-check-native",
      "displayName": "CPU check build with the native expert tests",
      "description": "As cpu-check plus the native (IQ) expert kernels and their tests. ggml comes from the vendored third_party/strata-ggml (no download); -DSTRATA_GGML_DIR=<llama.cpp checkout> overrides it.",
      "inherits": "cpu-check",
      "cacheVariables": {
        "STRATA_NATIVE_EXPERTS": "ON"
      }
    },
    {
      "name": "cuda-compile",
      "displayName": "CUDA compile-only (the release flags of packaging/build_cuda_linux.sh, no tests)",
      "description": "Builds the strata and strata_kq targets for the given CUDA architectures. No GPU is needed to compile; nothing is run. ggml is the vendored third_party/strata-ggml; -DSTRATA_GGML_DIR=<llama.cpp checkout> overrides it (CI still passes one).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STRATA_ENABLE_CUDA": "ON",
        "STRATA_BUILD_TESTS": "OFF",
        "STRATA_NATIVE_EXPERTS": "ON",
        "STRATA_PORTABLE": "ON",
        "STRATA_Q6K_EXPERTS": "ON",
        "STRATA_MMQ_KQUANTS": "ON",
        "STRATA_EXPERIMENTAL_SM60": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "86-real;89-real;89-virtual"
      }
    },
    {
      "name": "hip-compile",
      "displayName": "HIP compile-only (the release flags of packaging/build_hip_linux.sh, no tests)",
      "description": "Builds the strata target for gfx1100 and gfx1201 with ROCm's hipcc. ggml is the vendored third_party/strata-ggml (-DSTRATA_GGML_DIR=<llama.cpp checkout> overrides it); if hipcc is not on PATH pass -DCMAKE_HIP_COMPILER=<rocm>/llvm/bin/clang++.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STRATA_ENABLE_HIP": "ON",
        "STRATA_ENABLE_CUDA": "OFF",
        "STRATA_BUILD_TESTS": "OFF",
        "STRATA_PREFILL_MMQ": "ON",
        "STRATA_PORTABLE": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx1100;gfx1201"
      }
    },
    {
      "name": "hip-gfx906",
      "displayName": "Experimental MI50 gfx906, ROCm /opt/rocm, portable AVX2 host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-hip",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_HIP_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "CMAKE_HIP_COMPILER_ROCM_ROOT": "/opt/rocm",
        "CMAKE_PREFIX_PATH": "/opt/rocm",
        "CMAKE_HIP_ARCHITECTURES": "gfx906",
        "STRATA_ENABLE_HIP": "ON",
        "STRATA_ENABLE_CUDA": "OFF",
        "STRATA_EXPERIMENTAL_GFX906": "ON",
        "STRATA_PREFILL_MMQ": "ON",
        "STRATA_PORTABLE": "ON",
        "STRATA_BUILD_TESTS": "OFF",
        "STRATA_HIP_MULTIGPU_TESTS": "OFF",
        "STRATA_GGML_DIR": "${sourceDir}/third_party/llama.cpp"
      }
    },
    {
      "name": "hip-gfx906-multigpu",
      "inherits": "hip-gfx906",
      "displayName": "MI50 gfx906 with tests requiring two visible GPUs",
      "cacheVariables": {
        "STRATA_HIP_MULTIGPU_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-check",
      "configurePreset": "cpu-check",
      "jobs": 0
    },
    {
      "name": "cpu-check-native",
      "configurePreset": "cpu-check-native",
      "jobs": 0
    },
    {
      "name": "cuda-compile",
      "configurePreset": "cuda-compile",
      "targets": [
        "strata",
        "strata_kq"
      ],
      "jobs": 0
    },
    {
      "name": "hip-compile",
      "configurePreset": "hip-compile",
      "targets": [
        "strata"
      ],
      "jobs": 0
    },
    {
      "name": "hip-gfx906",
      "configurePreset": "hip-gfx906",
      "jobs": 2
    },
    {
      "name": "hip-gfx906-multigpu",
      "configurePreset": "hip-gfx906-multigpu",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "cpu-check",
      "configurePreset": "cpu-check",
      "output": {
        "outputOnFailure": true,
        "shortProgress": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error",
        "jobs": 4
      }
    },
    {
      "name": "cpu-check-native",
      "configurePreset": "cpu-check-native",
      "inherits": "cpu-check"
    },
    {
      "name": "hip-gfx906",
      "configurePreset": "hip-gfx906",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "name": "^(ple_parity|platform_memory_test)$"
        }
      },
      "environment": {
        "HIP_VISIBLE_DEVICES": "0",
        "ROCR_VISIBLE_DEVICES": null,
        "CUDA_VISIBLE_DEVICES": null
      }
    },
    {
      "name": "hip-gfx906-multigpu",
      "configurePreset": "hip-gfx906-multigpu",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      },
      "filter": {
        "exclude": {
          "name": "^(ple_parity|platform_memory_test)$"
        }
      },
      "environment": {
        "HIP_VISIBLE_DEVICES": "0,1",
        "ROCR_VISIBLE_DEVICES": null,
        "CUDA_VISIBLE_DEVICES": null
      }
    }
  ]
}
