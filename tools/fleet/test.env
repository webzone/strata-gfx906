# Literal KEY=VALUE values for fleet checks (no secrets). Point every HTTP client at a closed port:
# no check may download a model or any other file (owner rule 2026-11-28).
HTTP_PROXY=http://127.0.0.1:9
HTTPS_PROXY=http://127.0.0.1:9
http_proxy=http://127.0.0.1:9
https_proxy=http://127.0.0.1:9
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
HF_HUB_OFFLINE=1
